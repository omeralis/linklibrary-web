# ─────────────────────────────────────────────────────────────────────────────
# LinkLibrary web — environment
# Copy to .env.local (never commit .env.local).
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the Laravel API (no trailing slash, no /api/v1).
# Use "localhost" (not 127.0.0.1) so Sanctum session/XSRF cookies are shared with http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this frontend (used for canonical URLs, sitemap and Open Graph metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact address shown on /contact. Leave empty to hide the e-mail link.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Server-only (never prefixed with NEXT_PUBLIC_) ───────────────────────────
# Optional: API origin reachable from the Next.js server (defaults to NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=

# Optional shared secret matching the backend FRONTEND_SERVER_KEY. When set, server-rendered public
# pages send X-Frontend-Key + X-Client-IP so the API rate-limits by the visitor's IP, not the server's.
FRONTEND_SERVER_KEY=
